{
  "name": "anti-ai-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --var ARCHIVE_LOCAL_PREVIEW:1",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "translations:check": "node scripts/compile-translations.mjs --check",
    "translations:queue": "node scripts/translation-queue.mjs",
    "translations:import": "node scripts/import-translations.mjs",
    "content:check": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run translations:check && npm run content:check && npm run typecheck && npm test",
    "prebuild": "node scripts/prepare-datasets.mjs && node scripts/prepare-client-metadata.mjs && npm run translations:check && npm run content:check",
    "predev": "node scripts/prepare-datasets.mjs && node scripts/prepare-client-metadata.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261123.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "oxfmt": "0.80.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.65.1",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.167.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anti-ai-archive-local",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none"
  }
}
